# WineAPI key from https://wineapi.io/ (free personal tier)
WINEAPI_API_KEY=wapi_your_key_here

# Optional. Leave empty to hide Gemini. Free tier only; do not attach billing.
# gemini-3.5-flash-lite lists image input as free of charge.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Server only. Leave empty to skip GrapeMinds. Never use a NEXT_PUBLIC_ name.
# Set this in the host's environment. Do not commit a value.
GRAPEMINDS_API_KEY=
